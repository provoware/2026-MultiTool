{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PROVOWARE 2026-MultiTool",
  "version": "0.1.0",
  "identifier": "com.provoware.multitool2026",
  "build": {
    "frontendDist": "../src/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PROVOWARE 2026-MultiTool",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
